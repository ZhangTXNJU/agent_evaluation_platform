# ============================================================
# 旅行规划Agent平台 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ── 全局开关 ──────────────────────────────────────────────────
# 开启后所有工具使用模拟数据，无需任何API Key
MOCK_MODE=true

# ── 工具API提供商选择 ─────────────────────────────────────────
# 景点搜索：amap（高德）| baidu（百度）| google | mock
ATTRACTION_PROVIDER=amap

# 天气查询：qweather（和风）| openweather | mock
WEATHER_PROVIDER=qweather

# 交通计算：amap（高德）| baidu（百度）| google | mock
TRANSPORT_PROVIDER=amap

# 汇率查询：exchangerate | frankfurter | mock
CURRENCY_PROVIDER=exchangerate

# ── 高德地图 ──────────────────────────────────────────────────
# 注册：https://lbs.amap.com/
AMAP_KEY=your_amap_api_key_here

# ── 百度地图 ──────────────────────────────────────────────────
# 注册：https://lbsyun.baidu.com/
BAIDU_MAP_AK=your_baidu_ak_here

# ── Google Maps ───────────────────────────────────────────────
# 注册：https://console.cloud.google.com/
GOOGLE_MAPS_KEY=your_google_maps_key_here

# ── 和风天气 ──────────────────────────────────────────────────
# 注册：https://dev.qweather.com/
QWEATHER_KEY=your_qweather_key_here

# ── OpenWeatherMap ────────────────────────────────────────────
# 注册：https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_key_here

# ── LLM（DeepSeek）────────────────────────────────────────────
# 注册：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
